# App
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
WEB_URL=http://localhost:5173

# Database (local dev: docker-compose mongo; staging/prod: MongoDB Atlas connection string)
MONGODB_URI=mongodb://localhost:27017/smart-grants

# Redis (local dev: docker-compose redis; staging/prod: Upstash Redis URL)
REDIS_URL=redis://localhost:6379

# Auth (JWT)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# PayU (sandbox by default; production URL: https://secure.payu.com)
PAYU_API_URL=https://secure.snd.payu.com
PAYU_CLIENT_ID=
PAYU_CLIENT_SECRET=
PAYU_POS_ID=
PAYU_SECOND_KEY=
