{
  "name": "smart-grants",
  "version": "0.0.0",
  "private": true,
  "description": "Platforma agregujaca dotacje/kredyty UE i krajowe (Polska) - monorepo",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "build:api": "npm run build --workspace=api",
    "build:web": "npm run build --workspace=web",
    "build": "npm run build:api && npm run build:web",
    "lint:api": "npm run lint --workspace=api",
    "lint:web": "npm run lint --workspace=web",
    "lint": "npm run lint:api && npm run lint:web",
    "test:api": "npm run test --workspace=api",
    "test:e2e:api": "npm run test:e2e --workspace=api",
    "test:web": "npm run test --workspace=web",
    "test": "npm run test:api && npm run test:web"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
